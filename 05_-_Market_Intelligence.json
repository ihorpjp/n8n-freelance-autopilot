    {
      "parameters": {
        "jsCode": "const jobs = $input.all();\nconst total = jobs.length;\nconst avgScore = total > 0 \n  ? (jobs.reduce((sum, j) => sum + (j.json.score || 0), 0) / total).toFixed(1)\n  : 0;\nconst highScore = jobs.filter(j => j.json.score >= 7).length;\n\n// Собираем все источники\nconst sources = {};\njobs.forEach(j => {\n  const src = j.json.source || 'Unknown';\n  sources[src] = (sources[src] || 0) + 1;\n});\n\nconst topSources = Object.entries(sources)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 3)\n  .map(([src, count]) => `• ${src}: ${count}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    total,\n    avgScore,\n    highScore,\n    topSources\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
